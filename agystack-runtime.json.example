{
  "runtime": "cloud-run",
  "project_id": "your-gcp-project-id",
  "region": "us-central1",
  "job_name": "agystack-swarm-worker",
  "image": "us-central1-docker.pkg.dev/your-gcp-project-id/agystack/worker:latest",
  "parallelism": 16,
  "execution_limits": {
    "max_agent_turns": 30,
    "command_timeout_s": 300,
    "verify_timeout_s": 300
  },
  "model": "inherit",
  "auth_mode": "vertex",
  "vertex_location": "global",
  "gcs_bucket": "your-gcp-project-id-swarm-results"
}
